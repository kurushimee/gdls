/target
**/*.rs.bk
# cargo-fuzz build artifacts (the corpus under fuzz/corpus is committed; artifacts are not)
/crates/*/fuzz/target
/crates/*/fuzz/artifacts
# generated native-class API dumps used for local testing
/api/extension_api*.json
# local Claude Code / orchestration state (worktrees, plan artifacts, per-worktree settings,
# agent-memory symlinks) — tool-local, never part of the shipped sources
/.claude/
# warm-start index cache directories — written by the server into <project-root>/.gdls/ at
# runtime; never committed (each developer's cache is local and build-config-keyed)
**/.gdls/

# Acceptance-sweep artifacts (`scripts/acceptance/scan_diags.py`); the kept baselines live outside the repo.
scan-report.json
scan-report-stderr.log
